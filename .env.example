# ─────────────────────────────────────────────
# Webflow Webhook - Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local for local dev
# Add these in Vercel Dashboard → Project → Settings → Environment Variables

# Your Webflow API Token
# Get it from: Webflow Dashboard → Account Settings → API Access → Generate Token
WEBFLOW_API_TOKEN=your_webflow_api_token_here

# Your Webflow CMS Collection ID (the "Leads" collection you create)
# Get it from: Webflow Dashboard → CMS → Your Collection → Settings → Collection ID
WEBFLOW_COLLECTION_ID=your_collection_id_here
